:80 {
	# One canonical hostname. www still needs to resolve and still needs a
	# cert (the browser validates TLS before it ever sees this redirect),
	# but it should never serve the site itself.
	@www host www.tlflow.cc
	redir @www https://tlflow.cc{uri} permanent

	root * /srv
	encode zstd gzip
	file_server

	# Astro fingerprints these filenames, so they can be cached forever.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML must revalidate or a deploy never reaches anyone.
	@html path / *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"
}
