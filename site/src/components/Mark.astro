---
// The logo, drawing itself.
//
// The artwork is the FAITHFUL outline trace of brand/logo.png — filled
// paths following the true boundary of each colour region. A fill cannot be
// dash-animated, so the reveal comes from a mask instead: the centerline of
// the same artwork, stroked wide enough to cover the mark, sweeping along
// its real path — the curve is inquiry, the arrow is flow.
//
// The sweep can never reveal 100%: the arrowhead is far wider than the
// ribbon, and the bar's left wedge is navy-only so the ribbon's skeleton
// never passes through it. A full-coverage panel settles in as the arrow
// lands, which guarantees the finished mark is whole and means future
// artwork changes cannot silently clip it.
//
// Both paths and the mask width are generated by brand/build-logo.py.
import logo from '../data/logo.json';

interface Props {
  size?: string;
  animate?: boolean;
}
const { size = 'clamp(15rem, 32vw, 27rem)', animate = true } = Astro.props;
---

<div class:list={['mark', animate && 'mark--anim']} style={`--mark-w:${size}`}>
  <svg viewBox={logo.viewBox} role="img" aria-label="Throughline">
    <defs>
      <mask id="tl-reveal" maskUnits="userSpaceOnUse">
        <path
          class="mark__sweep"
          d={logo.centerline}
          fill="none"
          stroke="#fff"
          stroke-width={logo.maskWidth}
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <rect class="mark__settle" x="0" y="0" width="1000" height={logo.height} fill="#fff"
        ></rect>
      </mask>
    </defs>
    <g class="mark__art">
      <path fill={logo.fills.rim} fill-rule="evenodd" d={logo.outline.rim}></path>
      <path fill={logo.fills.body} fill-rule="evenodd" d={logo.outline.body}></path>
      <path fill={logo.fills.ink} fill-rule="evenodd" d={logo.outline.ink}></path>
    </g>
  </svg>
</div>

<style>
  .mark {
    width: var(--mark-w);
    filter: drop-shadow(0 0 24px color-mix(in srgb, var(--cyan) 26%, transparent));
  }

  .mark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* The mask is applied from CSS, not as an attribute, so it can be switched
     off wholesale when motion is unwanted. */
  .mark--anim .mark__art {
    mask: url(#tl-reveal);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mark--anim .mark__sweep {
      stroke-dasharray: var(--len, 1400);
      stroke-dashoffset: var(--len, 1400);
      animation: mark-draw 1.35s cubic-bezier(0.4, 0.05, 0.2, 1) forwards;
    }

    .mark--anim .mark__settle {
      opacity: 0;
      animation: mark-arrive 0.42s cubic-bezier(0.2, 0.8, 0.3, 1) 1.02s forwards;
    }

    @keyframes mark-draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes mark-arrive {
      to {
        opacity: 1;
      }
    }
  }

  /* No motion: drop the mask entirely so the full mark is simply present. */
  @media (prefers-reduced-motion: reduce) {
    .mark--anim .mark__art {
      mask: none;
    }
  }
</style>

<script>
  // Measure the real path length so the sweep neither over- nor under-runs.
  const sweep = document.querySelector<SVGPathElement>('.mark__sweep');
  if (sweep) {
    sweep.style.setProperty('--len', String(Math.ceil(sweep.getTotalLength())));
  }
</script>
