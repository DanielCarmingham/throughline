---
// The logo, traced from the original artwork (image.png) rather than
// redrawn: the white inner ribbon was thresholded, thinned to a one-pixel
// skeleton, and fitted to beziers, so this is the real geometry as an open
// path. Being a path rather than a raster is what lets it recolour per
// theme and draw itself on load — the curve is inquiry, the arrow is flow.
interface Props {
  size?: string;
  animate?: boolean;
}
const { size = 'clamp(15rem, 32vw, 27rem)', animate = true } = Astro.props;

const PATH =
  'M223.0 58.8 C223.6 57.4 225.8 53.9 226.7 50.6 C227.5 47.2 229.0 42.9 228.3 38.7 ' +
  'C227.6 34.4 226.1 29.6 222.4 25.1 C218.6 20.6 212.8 15.5 205.8 11.9 ' +
  'C198.9 8.3 190.1 5.3 180.7 3.3 C171.4 1.3 161.4 0.1 149.7 0.0 ' +
  'C137.9 -0.1 122.2 1.0 110.4 3.0 C98.5 4.9 88.7 7.8 78.3 11.6 ' +
  'C67.9 15.4 56.5 20.8 47.9 25.8 C39.3 30.7 33.1 35.5 26.8 41.3 ' +
  'C20.4 47.1 13.8 54.5 9.6 60.8 C5.3 67.1 2.8 73.2 1.3 79.3 ' +
  'C-0.2 85.4 -0.6 91.5 0.7 97.5 C1.9 103.5 5.0 110.1 8.6 115.3 ' +
  'C12.2 120.5 16.6 124.3 22.1 128.5 C27.7 132.8 34.3 137.2 42.0 140.7 ' +
  'C49.7 144.3 64.0 148.5 68.4 150.0 L297.0 154.0';

// Head proportions measured from the same artwork.
const HEAD_RIM = 'M238 86 L340 154 L238 222 Z';
const HEAD = 'M243 92 L334 154 L243 216 Z';
const HEAD_INNER = 'M256 111 L309 154 L256 197 Z';
---

<div class:list={['mark', animate && 'mark--anim']} style={`--mark-w:${size}`}>
  <svg viewBox="-26 -26 376 250" role="img" aria-label="Throughline">
    <path class="mark__rim" d={PATH}></path>
    <path class="mark__head-rim" d={HEAD_RIM}></path>
    <path class="mark__body" d={PATH}></path>
    <path class="mark__head" d={HEAD}></path>
    <path class="mark__inner" d={PATH}></path>
    <path class="mark__head-inner" d={HEAD_INNER}></path>
  </svg>
</div>

<style>
  .mark {
    width: var(--mark-w);
    filter: drop-shadow(0 0 24px color-mix(in srgb, var(--cyan) 26%, transparent));
  }

  .mark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Three layers, matching the artwork: a cyan rim, a navy body, and the
     white ribbon down the middle. Colours sampled from the source PNG, so
     the mark is self-contained and needs no per-theme variant. */
  .mark__rim,
  .mark__body,
  .mark__inner {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mark__rim {
    stroke: var(--logo-rim);
    stroke-width: 48;
  }

  .mark__body {
    stroke: var(--logo-body);
    stroke-width: 40;
  }

  .mark__inner {
    stroke: var(--logo-ink);
    stroke-width: 12;
  }

  .mark__head-rim {
    fill: var(--logo-rim);
  }

  .mark__head {
    fill: var(--logo-body);
  }

  .mark__head-inner {
    fill: var(--logo-ink);
  }

  /* The one orchestrated page-load moment: the curve strokes in, then the
     head arrives. */
  @media (prefers-reduced-motion: no-preference) {
    .mark--anim .mark__rim,
    .mark--anim .mark__body,
    .mark--anim .mark__inner {
      stroke-dasharray: var(--len, 760);
      stroke-dashoffset: var(--len, 760);
      animation: mark-draw 1.25s cubic-bezier(0.4, 0.05, 0.2, 1) forwards;
    }

    .mark--anim .mark__inner {
      animation-delay: 0.05s;
    }

    .mark--anim .mark__head-rim,
    .mark--anim .mark__head,
    .mark--anim .mark__head-inner {
      opacity: 0;
      transform: translateX(-20px);
      animation: mark-arrive 0.4s cubic-bezier(0.2, 0.8, 0.3, 1) 1.02s forwards;
    }

    @keyframes mark-draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes mark-arrive {
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  // Measure the real path length so the reveal neither over- nor under-runs.
  for (const p of document.querySelectorAll<SVGPathElement>(
    '.mark__rim, .mark__body, .mark__inner'
  )) {
    p.style.setProperty('--len', String(Math.ceil(p.getTotalLength())));
  }
</script>
