---
// The page's navigation IS the tool's core view: a line of stops with
// Now at your scroll position and a bracket around what's on screen.
// Stops ahead dim with distance — progressive planning, applied to the
// chrome itself.
interface Props {
  stops: { id: string; label: string }[];
}
const { stops } = Astro.props;
---

<nav class="ribbon" aria-label="Sections">
  <div class="ribbon__track" data-track>
    <span class="ribbon__rule" aria-hidden="true"></span>
    <span class="ribbon__window" data-window aria-hidden="true"></span>
    <span class="ribbon__now" data-now aria-hidden="true"></span>
    <ol class="ribbon__stops">
      {
        stops.map((s) => (
          <li class="ribbon__stop" data-stop data-id={s.id}>
            <a href={`#${s.id}`}>
              <span class="ribbon__dot" aria-hidden="true" />
              <span class="ribbon__name">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <p class="ribbon__readout" data-readout aria-hidden="true"></p>
</nav>

<style>
  .ribbon {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    height: var(--ribbon-h);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: var(--gutter);
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--rule);
  }

  .ribbon__track {
    position: relative;
    flex: 1;
    height: 100%;
  }

  .ribbon__rule {
    position: absolute;
    inset-block: 50% auto;
    inset-inline: 0;
    height: 1px;
    background: var(--rule);
  }

  /* The window: what is on screen right now. */
  .ribbon__window {
    position: absolute;
    top: 50%;
    height: 1.4rem;
    translate: 0 -50%;
    left: var(--win-l, 0%);
    width: var(--win-w, 12%);
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    transition: left 0.12s linear, width 0.12s linear;
  }

  .ribbon__now {
    position: absolute;
    top: 50%;
    left: var(--now, 0%);
    width: 2px;
    height: 1.9rem;
    translate: -1px -50%;
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 70%, transparent);
    transition: left 0.12s linear;
  }

  .ribbon__stops {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ribbon__stop {
    position: absolute;
    top: 50%;
    left: var(--at, 0%);
    translate: -50% -50%;
  }

  .ribbon__stop a {
    display: block;
    padding: 0.7rem 0.45rem;
    text-decoration: none;
    line-height: 0;
  }

  .ribbon__dot {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--muted);
    background: var(--ground);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.3s ease;
    /* Distance from Now drives visibility: far work is barely there. */
    opacity: var(--vis, 1);
  }

  /* Behind Now is history: filled in, and it stays put. */
  .ribbon__stop[data-passed] .ribbon__dot {
    background: var(--muted);
    border-color: var(--muted);
    opacity: 1;
  }

  .ribbon__stop[data-current] .ribbon__dot {
    background: var(--accent);
    border-color: var(--accent);
    opacity: 1;
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  /* The name only appears on hover or focus — the ribbon is an
     instrument, not a menu. */
  .ribbon__name {
    position: absolute;
    bottom: calc(100% - 0.2rem);
    left: 50%;
    translate: -50% 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
    background: var(--raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.2rem 0.45rem;
    line-height: 1.2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .ribbon__stop a:hover .ribbon__name,
  .ribbon__stop a:focus-visible .ribbon__name {
    opacity: 1;
  }

  .ribbon__readout {
    margin: 0;
    min-width: 9.5rem;
    text-align: right;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .ribbon__readout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ribbon__window,
    .ribbon__now,
    .ribbon__dot {
      transition: none;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-track]');
  const nowEl = document.querySelector<HTMLElement>('[data-now]');
  const winEl = document.querySelector<HTMLElement>('[data-window]');
  const readout = document.querySelector<HTMLElement>('[data-readout]');
  const stops = [...document.querySelectorAll<HTMLElement>('[data-stop]')];

  const sections = stops
    .map((stop) => {
      const id = stop.dataset.id;
      const el = id ? document.getElementById(id) : null;
      return el ? { stop, el } : null;
    })
    .filter((x): x is { stop: HTMLElement; el: HTMLElement } => x !== null);

  const pct = (n: number) => `${(n * 100).toFixed(3)}%`;

  function update() {
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    const y = window.scrollY;
    const progress = docH > 0 ? Math.min(1, Math.max(0, y / docH)) : 0;

    nowEl?.style.setProperty('--now', pct(progress));

    // The window is literally the viewport, mapped onto the line.
    const full = document.documentElement.scrollHeight;
    winEl?.style.setProperty('--win-l', pct(y / full));
    winEl?.style.setProperty('--win-w', pct(window.innerHeight / full));

    // Position each stop where its section actually sits.
    for (const { stop, el } of sections) {
      const at = el.offsetTop / full;
      stop.style.setProperty('--at', pct(at));
    }

    // Which station are we in? The last one whose top is above the
    // middle of the viewport.
    const mid = y + window.innerHeight * 0.4;
    let current = -1;
    sections.forEach(({ el }, i) => {
      if (el.offsetTop <= mid) current = i;
    });

    sections.forEach(({ stop, el }, i) => {
      const distance = i - current;
      stop.toggleAttribute('data-passed', distance < 0);
      stop.toggleAttribute('data-current', distance === 0);
      // Detail decreases with distance from Now.
      const vis = distance <= 0 ? 1 : Math.max(0.22, 1 - distance * 0.19);
      stop.style.setProperty('--vis', String(vis));
      if (distance === 0 && readout) {
        readout.textContent = stop.dataset.id?.replace(/-/g, ' ') ?? '';
      }
    });
  }

  let queued = false;
  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      update();
    });
  }

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();

  // Figures resolve into the line as they arrive.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: '0px 0px -12% 0px' }
  );
  for (const fig of document.querySelectorAll('.figure')) io.observe(fig);
</script>
