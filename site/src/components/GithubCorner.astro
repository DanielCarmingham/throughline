---
// The familiar corner mark, recoloured to this page's palette so it reads as
// part of the design rather than a decal stuck on it. The geometry is the
// standard one — a recognisable shape is the whole point; inventing a new
// silhouette would just mean nobody knows what it is.
interface Props {
  href: string;
}
const { href } = Astro.props;

const FIELD = 'M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z';
const ARM =
  'M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 ' +
  'C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 ' +
  'C122.9,97.6 130.6,101.9 134.4,103.2';
const BODY =
  'M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.8 ' +
  'C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 ' +
  'C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 ' +
  'C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.5 187.2,61.5 190.9,65.1 ' +
  'C194.5,68.7 197.7,72.9 200.1,77.3 C213.8,80.1 216.0,84.8 216.0,84.8 ' +
  'C212.5,93.0 206.7,95.9 205.2,96.5 C205.0,102.2 202.8,107.6 198.1,112.3 ' +
  'C181.7,128.7 168.1,122.4 157.5,114.0 C157.7,116.3 156.9,119.3 154.3,122.5 ' +
  'L140.7,136.4 C139.6,137.5 141.0,141.3 141.1,141.2 Z';
---

<a class="corner" href={href} aria-label="Source on GitHub" rel="noopener">
  <svg viewBox="0 0 250 250" aria-hidden="true" focusable="false">
    <path class="corner__field" d={FIELD}></path>
    <path class="corner__arm" d={ARM}></path>
    <path class="corner__body" d={BODY}></path>
  </svg>
</a>

<style>
  .corner {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 30;
    width: clamp(58px, 6.5vw, 80px);
    height: clamp(58px, 6.5vw, 80px);
    display: block;
    line-height: 0;
  }

  .corner svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .corner__field {
    fill: var(--accent);
    transition: fill 0.2s ease;
  }

  /* The mark is cut out of the field, so it takes the page's ground colour. */
  .corner__arm,
  .corner__body {
    fill: var(--ground);
  }

  .corner:hover .corner__field,
  .corner:focus-visible .corner__field {
    fill: var(--text);
  }

  .corner:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .corner__arm {
      transform-origin: 130px 106px;
      transition: transform 0.3s cubic-bezier(0.3, 0.8, 0.3, 1);
    }
    .corner:hover .corner__arm,
    .corner:focus-visible .corner__arm {
      transform: rotate(-22deg);
    }
  }

  /* On a phone it would sit on top of the wordmark. */
  @media (max-width: 30rem) {
    .corner {
      width: 46px;
      height: 46px;
    }
  }
</style>
